# G1 スターターキット サイト設定サンプル
#
#   cp config/g1.env.example config/g1.env
#   （config/g1.env は .gitignore 済み。環境ごとの値はここだけに書く）
#
# 分からない項目は空のままでよい。tools/preflight.py と tools/lidar_probe.py が
# 実機から読み取って、埋めるべき値を教えてくれる。

# --- 有線（ロボット制御 / LiDAR） -------------------------------------------
# ロボットと繋がっている有線インターフェース名。`ip -br addr` で確認。
# 例: enp0s31f6, eth0, enx00e04c680001（USB-LAN アダプタ）
G1_WIRED_IFACE=enp0s31f6

# このPC が有線に持つ固定 IP。ロボットと同じ 192.168.123.0/24 に入れる。
# 既に .161(制御) / .164(開発PC2) が使われているので衝突しない番号を選ぶ。
G1_HOST_IP=192.168.123.222

# --- 機体 -------------------------------------------------------------------
# G1_23（23DoF・片腕5関節）か G1_29（29DoF・片腕7関節）。
# auto にすると preflight の判定結果を使う。手首の軸数が 1 なら 23、3 なら 29。
G1_ARM=auto

# --- LiDAR（点群を見ないなら触らなくてよい） ---------------------------------
# LiDAR の IP と機種は tools/lidar_probe.py --write-config が
# config/livox/active.json に直接書き込むので、ここには書かない。
#
# 上下逆さまに搭載されている場合は true（既定）。
# 判定: ./scripts/lidar_view.sh を起動した状態で
#       python3 tools/lidar_probe.py --orientation
G1_LIDAR_FLIP=true

# --- Quest / XR -------------------------------------------------------------
# Quest と同じネットワークに繋がっている無線インターフェース名。
# 空にすると scripts/*.sh が自動検出する。
G1_WIFI_IFACE=

# --- ROS 2 ------------------------------------------------------------------
# ロボットの Unitree DDS は domain 0 を使う。ROS 2 の既定も 0 なので、
# 分けておかないと互いにディスカバリのノイズを出し合う。0 以外にすること。
ROS_DOMAIN_ID=42
