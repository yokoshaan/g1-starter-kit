{
  "_comment": [
    "MID360s 用の雛形。tools/lidar_probe.py --write-config が",
    "この形を読んで config/livox/active.json を生成する。直接使わないこと。",
    "host_net_info の形式: 配列+host_ip（機種で違う。混同すると LiDAR が無反応になる）"
  ],
  "lidar_summary_info": {
    "lidar_type": 8
  },
  "Mid360s": {
    "lidar_net_info": {
      "cmd_data_port": 56100,
      "push_msg_port": 56200,
      "point_data_port": 56300,
      "imu_data_port": 56400,
      "log_data_port": 56500
    },
    "host_net_info": [
      {
        "host_ip": "HOST_IP_PLACEHOLDER",
        "cmd_data_port": 56101,
        "push_msg_port": 56201,
        "point_data_port": 56301,
        "imu_data_port": 56401,
        "log_data_port": 56501
      }
    ]
  },
  "lidar_configs": [
    {
      "ip": "LIDAR_IP_PLACEHOLDER",
      "pcl_data_type": 1,
      "pattern_mode": 0,
      "extrinsic_parameter": {
        "roll": 0.0,
        "pitch": 0.0,
        "yaw": 0.0,
        "x": 0,
        "y": 0,
        "z": 0
      }
    }
  ]
}
